# Copie para .env. Nunca faça commit de .env ou credenciais reais.
ELASTICSEARCH_URL=http://elasticsearch:9200
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=enade-questions
KAFKA_DLQ_TOPIC=enade-questions-dlq
KAFKA_GROUP_ID=enade-indexer
ELASTICSEARCH_INDEX=enade-questions-v1
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=60

# Usuários e perfis de laboratório (rede interna Compose somente)
LDAP_URL=ldap://ldap:389
LDAP_PEOPLE_DN=ou=people,dc=enade,dc=local
